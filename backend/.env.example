# AxWise Flow OSS — Backend Environment Configuration
# Copy this file to .env.oss and fill in your values:
#   cp .env.example .env.oss

# ============================================================
# REQUIRED
# ============================================================

# Enable OSS mode (disables Clerk authentication)
OSS_MODE=true

# Get your free API key from https://aistudio.google.com/app/api_keys
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/axwise

# ============================================================
# OPTIONAL — Sensible defaults are provided
# ============================================================

# Database credentials (used if DATABASE_URL is not set)
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=axwise

# Gemini model (default: models/gemini-3.1-flash)
# GEMINI_MODEL=models/gemini-3.1-flash

# Logging level
LOG_LEVEL=INFO

# Disable Clerk auth validation in OSS mode
ENABLE_CLERK_VALIDATION=false

# Processing concurrency
PAID_TIER_CONCURRENCY=10
