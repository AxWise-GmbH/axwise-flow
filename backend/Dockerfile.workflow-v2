FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY workflow_v2_requirements.lock /app/requirements.txt
RUN pip install --no-cache-dir --no-deps -r /app/requirements.txt \
    && pip check

COPY domain /app/backend/domain
COPY services/workflow_v2 /app/backend/services/workflow_v2
COPY services/llm/gemini_runtime.py /app/backend/services/llm/gemini_runtime.py
COPY services/generative/gemini_search_service.py /app/backend/services/generative/gemini_search_service.py
COPY services/generative/searxng_search_service.py /app/backend/services/generative/searxng_search_service.py
COPY api/routes/workflow_v2_operations.py /app/backend/api/routes/workflow_v2_operations.py
COPY api/routes/desktop_information.py /app/backend/api/routes/desktop_information.py
COPY api/workflow_v2_app.py /app/backend/api/workflow_v2_app.py
COPY api/workflow_v2_worker_app.py /app/backend/api/workflow_v2_worker_app.py

RUN useradd --create-home --shell /usr/sbin/nologin app \
    && chown -R app:app /app

USER app
EXPOSE 8080
CMD ["sh", "-c", "case ${AXWISE_PROCESS_ROLE:-api} in api) module=backend.api.workflow_v2_app:app ;; worker) module=backend.api.workflow_v2_worker_app:app ;; *) echo 'AXWISE_PROCESS_ROLE must be api or worker' >&2; exit 64 ;; esac; exec python -m uvicorn ${module} --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
