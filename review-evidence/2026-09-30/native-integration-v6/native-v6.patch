+mod crash_tests {
+    use super::*;
+
+    #[test]
+    fn crash_child_fixture() {
+        let Some(root) = std::env::var_os("GOOSE_CRASH_TEST_ROOT") else {
+            return;
+        };
+        let root = PathBuf::from(root);
+        let ctx = ToolCallContext::new("crash".into(), Some(root.clone()), None);
+        let files = ["a.ts", "b.ts"]
+            .iter()
+            .map(|name| PlannedFile {
+                before: Snapshot {
+                    path: root.join(name),
+                    bytes: Arc::new(b"original\n".to_vec()),
+                },
+                after: b"published\n".to_vec(),
+            })
+            .collect();
+        let _batch = Batch::publish(files, &ctx, &CancellationToken::new()).unwrap();
+        fs::write(root.join("ready"), b"ready").unwrap();
+        loop {
+            std::thread::sleep(Duration::from_millis(50));
+        }
+    }
+
+    #[test]
+    fn sigkill_recovery_restores_owned_bytes_and_preserves_intervening_edits() {
+        for intervene in [false, true] {
+            let dir = tempfile::tempdir().unwrap();
+            let root = dir.path().canonicalize().unwrap();
+            for name in ["a.ts", "b.ts"] {
+                fs::write(root.join(name), b"original\n").unwrap();
+            }
+            let mut child = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["crash_tests::crash_child_fixture", "--nocapture"])
+                .env("GOOSE_CRASH_TEST_ROOT", &root)
+                .stdout(Stdio::null())
+                .stderr(Stdio::null())
+                .spawn()
+                .unwrap();
+            let start = std::time::Instant::now();
+            while !root.join("ready").exists() {
+                assert!(start.elapsed() < Duration::from_secs(5));
+                assert!(child.try_wait().unwrap().is_none());
+                std::thread::sleep(Duration::from_millis(10));
+            }
+            child.kill().unwrap();
+            child.wait().unwrap();
+            if intervene {
+                fs::write(root.join("b.ts"), b"human edit\n").unwrap();
+            }
+            let ctx = ToolCallContext::new("crash".into(), Some(root.clone()), None);
+            assert!(super::super::journal::pending(&ctx).unwrap());
+            let result = super::super::journal::recover(&ctx).unwrap();
+            assert_eq!(fs::read(root.join("a.ts")).unwrap(), b"original\n");
+            assert_eq!(
+                fs::read(root.join("b.ts")).unwrap(),
+                if intervene {
+                    b"human edit\n".as_slice()
+                } else {
+                    b"original\n".as_slice()
+                }
+            );
+            assert_eq!(
+                result["status"],
+                if intervene {
+                    "recovery_conflict"
+                } else {
+                    "recovered"
+                }
+            );
+            assert_eq!(super::super::journal::pending(&ctx).unwrap(), intervene);
+        }
+    }
