+use super::{edits::read_file, lsp, workspace_path, workspace_root};
+use crate::agents::ToolCallContext;
+use ignore::WalkBuilder;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+use tokio_util::sync::CancellationToken;
+
+pub(super) const MAX_TARGETS: usize = 512;
+pub(super) const MAX_PLAN_BYTES: usize = 32 * 1024 * 1024;
+const MAX_INPUTS: usize = 10_000;
+const MAX_PROJECT_BYTES: usize = 128 * 1024 * 1024;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct InputGuard {
+    pub path: PathBuf,
+    pub sha256: String,
+    pub bytes: usize,
+}
+
+pub(super) fn digest(bytes: &[u8]) -> String {
+    super::edits::sha(bytes)
+}
+
+pub(super) fn same_family(a: &str, b: &str) -> bool {
+    fn family(language: &str) -> &str {
+        match language {
+            "typescript" | "typescriptreact" | "javascript" | "javascriptreact" => "typescript",
+            "c" | "cpp" => "cpp",
+            other => other,
+        }
+    }
+    family(a) == family(b)
+}
+
+fn configuration(path: &Path) -> bool {
+    let name = path
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or("");
+    ((name.starts_with("tsconfig") || name.starts_with("jsconfig")) && name.ends_with(".json"))
+        || matches!(
+            name,
+            "package.json"
+                | "package-lock.json"
+                | "pnpm-lock.yaml"
+                | "yarn.lock"
+                | "pyrightconfig.json"
+                | "pyproject.toml"
+                | "poetry.lock"
+                | "Cargo.toml"
+                | "Cargo.lock"
+                | "go.mod"
+                | "go.sum"
+                | "compile_commands.json"
+                | ".clangd"
+                | ".gitignore"
+                | ".ignore"
+        )
+}
+
+pub(super) fn paths(
+    ctx: &ToolCallContext,
+    root: &Path,
+    language: &str,
+    token: &CancellationToken,
+) -> Result<Vec<PathBuf>, String> {
+    if workspace_root(ctx)? != root {
+        return Err("WORKSPACE_CHANGED".into());
+    }
+    let start = Instant::now();
+    let mut result = Vec::new();
+    let mut builder = WalkBuilder::new(root);
+    builder
+        .standard_filters(false)
+        .follow_links(false)
+        .hidden(false)
+        .sort_by_file_name(|a, b| a.cmp(b));
+    builder.filter_entry(|entry| {
+        !entry.file_type().is_some_and(|kind| kind.is_dir())
+            || !matches!(
+                entry.file_name().to_str(),
+                Some(".git" | "node_modules" | "target" | ".venv" | ".goose-native-recovery")
+            )
+    });
+    for (index, entry) in builder.build().enumerate() {
+        if token.is_cancelled() {
+            return Err("CANCELLED".into());
+        }
+        if index >= 100_000 || start.elapsed() > Duration::from_secs(10) {
+            return Err("PROJECT_BUDGET: Enumeration exceeded its entry/time budget.".into());
+        }
+        let entry = entry.map_err(|_| "PROJECT_UNAVAILABLE: Cannot enumerate every input.")?;
+        if entry.file_type().is_some_and(|kind| kind.is_dir()) {
+            continue;
+        }
+        let input = entry.path();
+        if !configuration(input)
+            && !lsp::language_for(input, None).is_some_and(|value| same_family(value, language))
+        {
+            continue;
+        }
+        result.push(workspace_path(
+            ctx,
+            input.to_str().ok_or("UNSUPPORTED_PATH_ENCODING")?,
+        )?);
+        if result.len() > MAX_INPUTS {
+            return Err("PROJECT_BUDGET: More than 10000 source/config inputs.".into());
+        }
+    }
+    // Ignore rules themselves must be guarded even when they hide other inputs.
+    for name in [".gitignore", ".ignore"] {
+        let path = root.join(name);
+        if path.exists() {
+            result.push(workspace_path(
+                ctx,
+                path.to_str().ok_or("UNSUPPORTED_PATH_ENCODING")?,
+            )?);
+        }
+    }
+    result.sort();
+    result.dedup();
+    Ok(result)
+}
+
+pub(super) fn capture(
+    ctx: &ToolCallContext,
+    root: &Path,
+    language: &str,
+    token: &CancellationToken,
+) -> Result<Vec<InputGuard>, String> {
+    let mut total = 0;
+    let mut guards = Vec::new();
+    for path in paths(ctx, root, language, token)? {
+        if token.is_cancelled() {
+            return Err("CANCELLED".into());
+        }
+        let (bytes, _) = read_file(&path)?;
+        total += bytes.len();
+        if total > MAX_PROJECT_BYTES {
+            return Err("PROJECT_BUDGET: Source/config inputs exceed 128 MiB.".into());
+        }
+        guards.push(InputGuard {
+            path,
+            sha256: digest(&bytes),
+            bytes: bytes.len(),
+        });
+    }
+    Ok(guards)
+}
+
+pub(super) async fn capture_async(
+    ctx: &ToolCallContext,
+    root: &Path,
+    language: &str,
+    token: &CancellationToken,
+) -> Result<Vec<InputGuard>, String> {
+    let task_token = token.child_token();
+    let _guard = task_token.clone().drop_guard();
+    let ctx = ctx.clone();
+    let root = root.to_owned();
+    let language = language.to_owned();
+    tokio::time::timeout(
+        Duration::from_secs(15),
+        tokio::task::spawn_blocking(move || capture(&ctx, &root, &language, &task_token)),
+    )
+    .await
+    .map_err(|_| "PROJECT_TIMEOUT".to_string())?
+    .map_err(|_| "PROJECT_SCAN_FAILED".to_string())?
+}
+
+pub(super) fn configured_typescript_project(root: &Path, source: &Path) -> bool {
+    let mut directory = source.parent();
+    while let Some(parent) = directory {
+        if parent.join("tsconfig.json").is_file() || parent.join("jsconfig.json").is_file() {
+            return true;
+        }
+        if parent == root {
+            break;
+        }
+        directory = parent.parent();
+    }
+    false
+}
