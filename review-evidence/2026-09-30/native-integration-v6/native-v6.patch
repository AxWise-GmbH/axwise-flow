+fn compact_receipt(mut value: Value) -> Value {
+    fn read(value: &mut Value) {
+        if let Some(rows) = value.get("lines").and_then(Value::as_array) {
+            let text = rows
+                .iter()
+                .map(|row| {
+                    format!(
+                        "{}\t{}",
+                        row["anchor"].as_str().unwrap_or(""),
+                        row["text"].as_str().unwrap_or("")
+                    )
+                })
+                .collect::<Vec<_>>()
+                .join("");
+            value.as_object_mut().expect("read object").remove("lines");
+            value["text"] = json!(text);
+            value["format"] = json!("anchor-tab-source; original line endings retained");
+        }
+    }
+    read(&mut value);
+    if value["status"] == "read_many" {
+        if let Some(files) = value["files"].as_array_mut() {
+            for file in files {
+                read(file);
+            }
+        }
+    }
+    if value["verified"] == true {
+        if let Some(test) = value.get_mut("test").and_then(Value::as_object_mut) {
+            for field in ["stdout", "stderr"] {
+                if let Some(output) = test.get(field).and_then(Value::as_str) {
+                    let count = output.len();
+                    let tail = output
+                        .chars()
+                        .rev()
+                        .take(2048)
+                        .collect::<String>()
+                        .chars()
+                        .rev()
+                        .collect::<String>();
+                    test.insert(field.to_owned(), json!(tail));
+                    test.insert(format!("{field}_bytes"), json!(count));
+                    test.insert(format!("{field}_summarized"), json!(count > 2048));
+                }
+            }
+        }
+        if let Some(files) = value["files"].as_array_mut() {
+            for file in files {
+                if let Some(row) = file.as_object_mut() {
+                    row.remove("before_sha256");
+                    row.remove("edited_sha256");
+                }
+            }
+        }
+        if let Some(post) = value.get_mut("post_edit") {
+            if post.is_object() {
+                read(post);
+            }
+        }
+    }
+    value
