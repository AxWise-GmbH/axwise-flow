+use super::{
+    edits::{atomic_replace, read_file, EditLock, Transaction},
+    project, workspace_path, workspace_root,
+};
+use crate::agents::ToolCallContext;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::fs::{self, File, OpenOptions};
+use std::io::{Read, Write};
+use std::path::{Path, PathBuf};
+
+const DIRECTORY: &str = ".goose-native-recovery";
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Record {
+    root: PathBuf,
+    files: Vec<Target>,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Target {
+    path: PathBuf,
+    offset: usize,
+    bytes: usize,
+    before: String,
+    after: String,
+    mode: u32,
+}
+
+fn private_directory(path: &Path) -> Result<(), String> {
+    let mut builder = fs::DirBuilder::new();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::DirBuilderExt;
+        builder.mode(0o700);
+    }
+    match builder.create(path) {
+        Ok(()) => (),
+        Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => (),
+        Err(error) => return Err(error.to_string()),
+    }
+    let metadata = fs::symlink_metadata(path).map_err(|error| error.to_string())?;
+    if !metadata.is_dir() || metadata.file_type().is_symlink() {
+        return Err("UNSAFE_JOURNAL_DIRECTORY".into());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.uid() != unsafe { libc::geteuid() } || metadata.mode() & 0o077 != 0 {
+            return Err("UNSAFE_JOURNAL_DIRECTORY".into());
+        }
+    }
+    Ok(())
+}
+
+fn write_new(path: &Path, bytes: &[u8]) -> Result<(), String> {
+    let mut options = OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600).custom_flags(libc::O_NOFOLLOW);
+    }
+    let mut file = options.open(path).map_err(|error| error.to_string())?;
+    file.write_all(bytes)
+        .and_then(|()| file.sync_all())
+        .map_err(|error| error.to_string())
+}
+
+fn bounded_read(path: &Path, limit: usize) -> Result<Vec<u8>, String> {
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    }
+    let file = options.open(path).map_err(|error| error.to_string())?;
+    if !file
+        .metadata()
+        .map_err(|error| error.to_string())?
+        .is_file()
+    {
+        return Err("UNSAFE_JOURNAL_FILE".into());
+    }
+    let mut bytes = Vec::new();
+    file.take(limit as u64 + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|error| error.to_string())?;
+    if bytes.len() > limit {
+        return Err("JOURNAL_BUDGET".into());
+    }
+    Ok(bytes)
+}
+
+pub(super) struct Journal {
+    directory: PathBuf,
+}
+impl Journal {
+    pub fn prepare(ctx: &ToolCallContext, transactions: &[Transaction]) -> Result<Self, String> {
+        let root = workspace_root(ctx)?;
+        let parent = root.join(DIRECTORY);
+        private_directory(&parent)?;
+        let directory = parent.join(uuid::Uuid::new_v4().simple().to_string());
+        private_directory(&directory)?;
+        let mut preimages = Vec::new();
+        let mut files = Vec::new();
+        for transaction in transactions {
+            if preimages.len() + transaction.original.len() > project::MAX_PLAN_BYTES {
+                return Err("JOURNAL_BUDGET".into());
+            }
+            #[cfg(unix)]
+            let mode = {
+                use std::os::unix::fs::PermissionsExt;
+                transaction.permissions.mode()
+            };
+            #[cfg(not(unix))]
+            let mode = 0;
+            files.push(Target {
+                path: transaction
+                    .path
+                    .strip_prefix(&root)
+                    .map_err(|_| "JOURNAL_PATH")?
+                    .to_owned(),
+                offset: preimages.len(),
+                bytes: transaction.original.len(),
+                before: project::digest(&transaction.original),
+                after: project::digest(&transaction.postimage),
+                mode,
+            });
+            preimages.extend_from_slice(&transaction.original);
+        }
+        write_new(&directory.join("preimages.bin"), &preimages)?;
+        write_new(
+            &directory.join("record.json"),
+            &serde_json::to_vec(&Record {
+                root: root.clone(),
+                files,
+            })
+            .map_err(|error| error.to_string())?,
+        )?;
+        File::open(&directory)
+            .and_then(|file| file.sync_all())
+            .map_err(|error| error.to_string())?;
+        File::open(&parent)
+            .and_then(|file| file.sync_all())
+            .map_err(|error| error.to_string())?;
+        File::open(&root)
+            .and_then(|file| file.sync_all())
+            .map_err(|error| error.to_string())?;
+        Ok(Self { directory })
+    }
+    pub fn commit(&self) -> Result<(), String> {
+        write_new(&self.directory.join("committed"), b"publication accepted\n")?;
+        File::open(&self.directory)
+            .and_then(|file| file.sync_all())
+            .map_err(|error| error.to_string())?;
+        // A crash after the durable marker must not undo a verified publication.
+        let _ = fs::remove_dir_all(&self.directory);
+        Ok(())
+    }
+    pub fn clear_after_rollback(&self) {
+        let _ = fs::remove_dir_all(&self.directory);
+    }
+}
+
+pub(super) fn pending(ctx: &ToolCallContext) -> Result<bool, String> {
+    let parent = workspace_root(ctx)?.join(DIRECTORY);
+    if !parent.exists() {
+        return Ok(false);
+    }
+    private_directory(&parent)?;
+    for entry in fs::read_dir(&parent).map_err(|error| error.to_string())? {
+        let entry = entry.map_err(|error| error.to_string())?;
+        let path = entry.path();
+        if path.join("record.json").exists() && !path.join("committed").exists() {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
+
+pub(super) fn recover(ctx: &ToolCallContext) -> Result<Value, String> {
+    let root = workspace_root(ctx)?;
+    let parent = root.join(DIRECTORY);
+    let mut results = Vec::new();
+    if !parent.exists() {
+        return Ok(json!({"status":"recovered","verified":false,"files":[]}));
+    }
+    private_directory(&parent)?;
+    let entries = fs::read_dir(&parent)
+        .map_err(|error| error.to_string())?
+        .collect::<Result<Vec<_>, _>>()
+        .map_err(|error| error.to_string())?;
+    if entries.len() > 128 {
+        return Err("JOURNAL_BUDGET: Too many recovery records.".into());
+    }
+    for entry in entries {
+        let directory = entry.path();
+        private_directory(&directory)?;
+        if directory.join("committed").exists() {
+            fs::remove_dir_all(&directory).map_err(|error| error.to_string())?;
+            continue;
+        }
+        if !directory.join("record.json").exists() {
+            continue;
+        }
+        let record: Record =
+            serde_json::from_slice(&bounded_read(&directory.join("record.json"), 1024 * 1024)?)
+                .map_err(|_| "INVALID_JOURNAL")?;
+        if record.root != root
+            || record.files.is_empty()
+            || record.files.len() > project::MAX_TARGETS
+        {
+            return Err("INVALID_JOURNAL".into());
+        }
+        let bytes = bounded_read(&directory.join("preimages.bin"), project::MAX_PLAN_BYTES)?;
+        let mut targets = Vec::new();
+        let mut names = std::collections::BTreeSet::new();
+        for target in record.files {
+            if target.path.is_absolute() || !names.insert(target.path.clone()) {
+                return Err("INVALID_JOURNAL".into());
+            }
+            let path = workspace_path(ctx, target.path.to_str().ok_or("JOURNAL_PATH")?)?;
+            let before = bytes
+                .get(
+                    target.offset
+                        ..target
+                            .offset
+                            .checked_add(target.bytes)
+                            .ok_or("INVALID_JOURNAL")?,
+                )
+                .ok_or("INVALID_JOURNAL")?;
+            if project::digest(before) != target.before {
+                return Err("INVALID_JOURNAL".into());
+            }
+            targets.push((path, target, before));
+        }
+        targets.sort_by(|a, b| a.0.cmp(&b.0));
+        let _locks = targets
+            .iter()
+            .map(|(path, _, _)| EditLock::acquire(path))
+            .collect::<Result<Vec<_>, _>>()?;
+        let mut conflicts = false;
+        for (path, target, before) in targets {
+            let (current, mut permissions) = read_file(&path)?;
+            let digest = project::digest(&current);
+            let restored = if digest == target.before {
+                true
+            } else if digest == target.after {
+                #[cfg(unix)]
+                {
+                    use std::os::unix::fs::PermissionsExt;
+                    permissions.set_mode(target.mode);
+                }
+                atomic_replace(ctx, &root, &path, &current, before, permissions)?;
+                true
+            } else {
+                conflicts = true;
+                false
+            };
+            results.push(json!({"path":path,"restored":restored,"reason":if restored {"owned_preimage_restored"} else {"intervening_modification_preserved"}}));
+        }
+        if !conflicts {
+            fs::remove_dir_all(&directory).map_err(|error| error.to_string())?;
+        }
+    }
+    Ok(
+        json!({"status":if results.iter().all(|row|row["restored"]==true){"recovered"}else{"recovery_conflict"},"verified":false,"files":results}),
+    )
+}
