+fn resolve_guard(
+    ctx: &ToolCallContext,
+    state: &EngineeringState,
+    path: &Path,
+    id: Option<&str>,
+    digest: Option<&str>,
+) -> Result<String, String> {
+    match (id, digest) {
+        (Some(id), None) => {
+            let snapshot = state.snapshot(ctx, id)?;
+            if snapshot.path != path {
+                return Err("SNAPSHOT_PATH_MISMATCH".into());
+            }
+            Ok(sha(&snapshot.bytes))
+        }
+        (None, Some(digest)) => Ok(digest.to_owned()),
+        _ => Err("GUARD_REQUIRED: Supply snapshot_id or expected_sha256, exactly one.".into()),
+    }
+}
