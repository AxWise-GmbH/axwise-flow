+        assert_eq!(fs::read(dir.path().join("a.txt")).unwrap(), b"a\n");
+        assert_eq!(fs::read(dir.path().join("b.txt")).unwrap(), b"external\n");
+        assert!(!dir.path().join("test-started").exists());
+    }
+
+    #[tokio::test]
+    async fn batch_tests_observe_complete_changes_and_failure_restores_both_files() {
+        for succeeds in [true, false] {
+            let (dir, ctx, client) = fixture();
+            let files = changes(&client, &ctx).await;
+            let script = if succeeds {
+                "test \"$(cat a.txt)\" = A && test \"$(cat b.txt)\" = B"
+            } else {
+                "exit 1"
+            };
+            let result = invoke(
+                &client,
+                &ctx,
