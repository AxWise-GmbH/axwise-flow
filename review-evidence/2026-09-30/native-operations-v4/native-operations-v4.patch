+pub(super) fn rename_scope_paths(
+    ctx: &ToolCallContext,
+    scope: &Path,
+    language: &str,
+    token: &CancellationToken,
+) -> Result<Vec<PathBuf>, String> {
+    let root = workspace_root(ctx)?;
+    let mut source_count = 0;
+    let mut paths = Vec::new();
+    let mut builder = WalkBuilder::new(scope);
+    builder
+        .follow_links(false)
+        .sort_by_file_name(|a, b| a.cmp(b));
+    for (index, entry) in builder.build().enumerate() {
+        if token.is_cancelled() {
+            return Err("CANCELLED".into());
+        }
+        if index >= 4096 {
+            return Err("SCOPE_TOO_LARGE: Narrow the rename directory.".into());
+        }
+        let entry = entry.map_err(|_| "SCOPE_UNAVAILABLE: Cannot enumerate every scope input.")?;
+        if entry.file_type().is_some_and(|kind| kind.is_dir()) {
+            continue;
+        }
+        let input = entry.path();
+        let selected =
+            language_for(input, None).is_some_and(|value| server_language(value) == language);
+        let config = input
+            .file_name()
+            .and_then(|name| name.to_str())
+            .is_some_and(|name| {
+                (name.starts_with("tsconfig") && name.ends_with(".json"))
+                    || name == "pyrightconfig.json"
+            });
+        if !selected && !config {
+            continue;
+        }
+        let path = workspace_path(ctx, input.to_str().ok_or("UNSUPPORTED_PATH_ENCODING")?)?;
+        if selected {
+            source_count += 1;
+        }
+        if source_count > MAX_DOCUMENTS || paths.len() >= 64 {
+            return Err("SCOPE_TOO_LARGE: Rename supports at most 32 language files and 64 total inputs; use a narrower scope or ordinary edits.".into());
+        }
+        paths.push(path);
+    }
+    // Ancestor configuration/ignore changes can alter the graph or scope membership.
+    let mut directory = Some(scope);
+    while let Some(parent) = directory {
+        for name in [
+            "tsconfig.json",
+            "jsconfig.json",
+            "pyrightconfig.json",
+            ".gitignore",
+        ] {
+            let config = parent.join(name);
+            if config.exists() {
+                paths.push(workspace_path(
+                    ctx,
+                    config.to_str().ok_or("UNSUPPORTED_PATH_ENCODING")?,
+                )?);
+            }
+        }
+        if parent == root {
+            break;
+        }
+        directory = parent.parent();
+    }
+    paths.sort();
+    paths.dedup();
+    if paths.len() > 64 {
+        return Err("SCOPE_TOO_LARGE: At most 64 source/config inputs are supported.".into());
+    }
+    Ok(paths)
+}
