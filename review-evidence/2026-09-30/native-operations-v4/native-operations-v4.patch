+fn prepare_changes(
+    files: Vec<FileChange>,
+    ctx: &ToolCallContext,
+    state: &EngineeringState,
+    token: &CancellationToken,
+) -> Result<Vec<PlannedFile>, String> {
+    if files.is_empty() || files.len() > 32 {
+        return Err("INVALID_FILES: Supply 1–32 files.".into());
+    }
+    let mut prepared = Vec::new();
+    let mut bytes = 0;
+    for file in files {
+        cancelled(token)?;
+        let path = workspace_path(ctx, &file.path)?;
+        let expected = resolve_guard(
+            ctx,
+            state,
+            &path,
+            file.snapshot_id.as_deref(),
+            file.expected_sha256.as_deref(),
+        )?;
+        let (original, _) = read_file(&path)?;
+        check_digest(&expected, &original)?;
+        let after = replacement(&original, &file.edits)?;
+        bytes += original.len() + after.len();
+        if bytes > 8 * 1024 * 1024 {
+            return Err("BATCH_TOO_LARGE: Narrow the change.".into());
+        }
+        prepared.push(PlannedFile {
+            before: Snapshot {
+                path,
+                bytes: Arc::new(original),
+            },
+            after,
+        });
+    }
+    Ok(prepared)
+}
+
+fn validate_plan(
+    plan: &ChangePlan,
+    ctx: &ToolCallContext,
+    token: &CancellationToken,
+) -> Result<(), String> {
+    cancelled(token)?;
+    if super::lsp::rename_scope_paths(ctx, &plan.scope, &plan.language, token)? != plan.scope_files
+    {
+        return Err("STALE_SCOPE: Files were added or removed; prepare a new rename plan.".into());
+    }
+    for snapshot in &plan.guards {
+        cancelled(token)?;
+        let path = workspace_path(
+            ctx,
+            snapshot.path.to_str().ok_or("UNSUPPORTED_PATH_ENCODING")?,
+        )?;
+        if read_file(&path)?.0 != *snapshot.bytes {
+            return Err("STALE_PLAN: A scope input changed; prepare a new plan.".into());
+        }
+    }
+    Ok(())
+}
+
+fn validate_plan_after(
+    plan: &ChangePlan,
+    ctx: &ToolCallContext,
+    token: &CancellationToken,
+) -> Result<(), String> {
+    let mut expected = plan.clone();
+    for snapshot in &mut expected.guards {
+        if let Some(file) = plan
+            .files
+            .iter()
+            .find(|file| file.before.path == snapshot.path)
+        {
+            snapshot.bytes = Arc::new(file.after.clone());
+        }
+    }
+    validate_plan(&expected, ctx, token)
+}
+
+struct Batch {
+    transactions: Vec<Transaction>,
+}
+impl Batch {
+    fn publish(
+        mut files: Vec<PlannedFile>,
+        ctx: &ToolCallContext,
+        token: &CancellationToken,
+    ) -> Result<Self, String> {
+        files.sort_by(|a, b| a.before.path.cmp(&b.before.path));
+        if files.is_empty()
+            || files
+                .windows(2)
+                .any(|f| f[0].before.path == f[1].before.path)
+        {
+            return Err("INVALID_FILES: File targets must be nonempty and unique.".into());
+        }
+        let root = workspace_root(ctx)?;
+        let mut batch = Self {
+            transactions: Vec::new(),
+        };
+        for file in files {
+            cancelled(token)?;
+            let path = workspace_path(
+                ctx,
+                file.before
+                    .path
+                    .to_str()
+                    .ok_or("UNSUPPORTED_PATH_ENCODING")?,
+            )?;
+            let lock = EditLock::acquire(&path)?;
+            let (original, permissions) = read_file(&path)?;
+            if original != *file.before.bytes {
+                return Err("STALE_PREIMAGE: No file was published; reread the batch.".into());
+            }
+            batch.transactions.push(Transaction {
+                ctx: ctx.clone(),
+                root: root.clone(),
+                path,
+                original,
+                postimage: file.after,
+                permissions,
+                active: false,
+                _lock: lock,
+            });
+        }
+        for index in 0..batch.transactions.len() {
+            if let Err(error) = cancelled(token).and_then(|()| {
+                let t = &batch.transactions[index];
+                atomic_replace(
+                    ctx,
+                    &root,
+                    &t.path,
+                    &t.original,
+                    &t.postimage,
+                    t.permissions.clone(),
+                )
+            }) {
+                let rollback = batch.rollback();
+                return Err(format!(
+                    "BATCH_PUBLICATION_FAILED: {error}; rollback={rollback}"
+                ));
+            }
+            batch.transactions[index].active = true;
+        }
+        Ok(batch)
+    }
+    fn unchanged(&self) -> bool {
+        self.transactions
+            .iter()
+            .all(|t| t.current().is_ok_and(|bytes| bytes == t.postimage))
+    }
+    fn commit(&mut self) {
+        for t in &mut self.transactions {
+            t.active = false;
+        }
+    }
+    fn rollback(&mut self) -> Value {
+        let files: Vec<_> = self
+            .transactions
+            .iter_mut()
+            .filter(|t| t.active)
+            .map(|t| {
+                let mut result = t.rollback();
+                result["path"] = json!(t.path);
+                result
+            })
+            .collect();
+        json!({"attempted":!files.is_empty(),"restored":files.iter().all(|f|f["restored"]==true),"files":files})
+    }
+    fn receipts(&self) -> Vec<Value> {
+        self.transactions.iter().map(|t|json!({"path":t.path,"before_sha256":sha(&t.original),"edited_sha256":sha(&t.postimage),"current_sha256":t.current().ok().map(|bytes|sha(&bytes))})).collect()
+    }
 }
 
