+struct EditPosition {
+    line: u32,
+    character: u32,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct EditRange {
+    start: EditPosition,
+    end: EditPosition,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RenameEdit {
+    range: EditRange,
+    #[serde(rename = "newText")]
+    new_text: String,
+}
+
+fn byte_position(text: &str, position: &EditPosition) -> Result<usize, String> {
+    let mut offset = 0;
+    let mut rows = text.split('\n');
+    for _ in 0..position.line {
+        offset += rows.next().ok_or("INVALID_EDIT_RANGE")?.len() + 1;
+    }
+    let row = rows.next().ok_or("INVALID_EDIT_RANGE")?;
+    let row = row.strip_suffix('\r').unwrap_or(row);
+    let mut utf16 = 0;
+    for (index, ch) in row.char_indices() {
+        if utf16 == position.character {
+            return Ok(offset + index);
+        }
+        utf16 += ch.len_utf16() as u32;
+    }
+    if utf16 == position.character {
+        Ok(offset + row.len())
+    } else {
+        Err("INVALID_EDIT_RANGE: Invalid UTF-16 boundary.".into())
+    }
+}
