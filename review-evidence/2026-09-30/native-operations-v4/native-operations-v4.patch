+            assert!(result.get("error").is_some(), "{result}");
+            assert_eq!(fs::read(dir.path().join("a.txt")).unwrap(), b"a\n");
+        }
+    }
+
+    #[tokio::test]
+    async fn failed_batch_preserves_intervening_changes_and_restores_other_owned_files() {
+        let (dir, ctx, client) = fixture();
+        let files = changes(&client, &ctx).await;
+        let result = invoke(&client,&ctx,"safe_edit_and_test",json!({"files":files,"test_command":["/bin/sh","-c","printf external > a.txt; exit 1"]}),CancellationToken::new()).await;
+        assert_eq!(result["verified"], false);
