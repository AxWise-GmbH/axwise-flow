+use super::workspace_root;
+use crate::agents::ToolCallContext;
+use std::collections::VecDeque;
+use std::path::PathBuf;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+const MAX_ENTRIES: usize = 128;
+const MAX_BYTES: usize = 16 * 1024 * 1024;
+const TTL: Duration = Duration::from_secs(600);
+
+#[derive(Clone)]
+pub(super) struct Snapshot {
+    pub path: PathBuf,
+    pub bytes: Arc<Vec<u8>>,
+}
+
+#[derive(Clone)]
+pub(super) struct PlannedFile {
+    pub before: Snapshot,
+    pub after: Vec<u8>,
+}
+
+#[derive(Clone)]
+pub(super) struct ChangePlan {
+    pub files: Vec<PlannedFile>,
+    pub guards: Vec<Snapshot>,
+    pub scope: PathBuf,
+    pub language: String,
+    pub scope_files: Vec<PathBuf>,
+}
+
+enum Stored {
+    Snapshot(Snapshot),
+    Plan(ChangePlan),
+}
+
+struct Entry {
+    id: String,
+    session: String,
+    root: PathBuf,
+    created: Instant,
+    size: usize,
+    value: Stored,
+}
+
+#[derive(Default)]
+pub(super) struct EngineeringState(Mutex<VecDeque<Entry>>);
+
+impl EngineeringState {
+    fn insert(&self, ctx: &ToolCallContext, value: Stored, size: usize) -> Result<String, String> {
+        if size > MAX_BYTES {
+            return Err("STATE_TOO_LARGE: Narrow the change scope.".into());
+        }
+        let root = workspace_root(ctx)?;
+        let id = uuid::Uuid::new_v4().simple().to_string();
+        let mut entries = self.0.lock().map_err(|_| "STATE_UNAVAILABLE")?;
+        entries.retain(|entry| entry.created.elapsed() < TTL);
+        let mut used: usize = entries.iter().map(|entry| entry.size).sum();
+        while entries.len() >= MAX_ENTRIES || used + size > MAX_BYTES {
+            used -= entries.pop_front().expect("nonempty bounded store").size;
+        }
+        entries.push_back(Entry {
+            id: id.clone(),
+            session: ctx.session_id.clone(),
+            root,
+            created: Instant::now(),
+            size,
+            value,
+        });
+        Ok(id)
+    }
+
+    pub fn save_snapshot(
+        &self,
+        ctx: &ToolCallContext,
+        snapshot: Snapshot,
+    ) -> Result<String, String> {
+        let size = snapshot.bytes.len();
+        self.insert(ctx, Stored::Snapshot(snapshot), size)
+    }
+
+    pub fn snapshot(&self, ctx: &ToolCallContext, id: &str) -> Result<Snapshot, String> {
+        let root = workspace_root(ctx)?;
+        let mut entries = self.0.lock().map_err(|_| "STATE_UNAVAILABLE")?;
+        entries.retain(|entry| entry.created.elapsed() < TTL);
+        match entries
+            .iter()
+            .find(|entry| entry.id == id && entry.session == ctx.session_id && entry.root == root)
+            .map(|entry| &entry.value)
+        {
+            Some(Stored::Snapshot(snapshot)) => Ok(snapshot.clone()),
+            _ => Err("SNAPSHOT_UNAVAILABLE: Read again in this session and workspace.".into()),
+        }
+    }
+
+    pub fn save_plan(&self, ctx: &ToolCallContext, plan: ChangePlan) -> Result<String, String> {
+        let size = plan.guards.iter().map(|s| s.bytes.len()).sum::<usize>()
+            + plan.files.iter().map(|f| f.after.len()).sum::<usize>();
+        self.insert(ctx, Stored::Plan(plan), size)
+    }
+
+    pub fn take_plan(&self, ctx: &ToolCallContext, id: &str) -> Result<ChangePlan, String> {
+        let root = workspace_root(ctx)?;
+        let mut entries = self.0.lock().map_err(|_| "STATE_UNAVAILABLE")?;
+        entries.retain(|entry| entry.created.elapsed() < TTL);
+        let index = entries
+            .iter()
+            .position(|entry| {
+                entry.id == id && entry.session == ctx.session_id && entry.root == root
+            })
+            .ok_or("PLAN_UNAVAILABLE: Prepare a fresh plan in this session and workspace.")?;
+        if !matches!(entries[index].value, Stored::Plan(_)) {
+            return Err("PLAN_UNAVAILABLE: Expected a change plan.".into());
+        }
+        match entries.remove(index).expect("located entry").value {
+            Stored::Plan(plan) => Ok(plan),
+            _ => unreachable!(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn snapshots_are_bound_to_session_root_lifetime_and_budget() {
+        let dir = tempfile::tempdir().unwrap();
+        let ctx = ToolCallContext::new("one".into(), Some(dir.path().to_owned()), None);
+        let state = EngineeringState::default();
+        let snapshot = Snapshot {
+            path: dir.path().join("file"),
+            bytes: Arc::new(b"original".to_vec()),
+        };
+        let id = state.save_snapshot(&ctx, snapshot.clone()).unwrap();
+        assert_eq!(&**state.snapshot(&ctx, &id).unwrap().bytes, b"original");
+        let other = ToolCallContext::new("two".into(), ctx.working_dir.clone(), None);
+        assert!(state.snapshot(&other, &id).is_err());
+        let other_root = tempfile::tempdir().unwrap();
+        let moved = ToolCallContext::new("one".into(), Some(other_root.path().to_owned()), None);
+        assert!(state.snapshot(&moved, &id).is_err());
+        state.0.lock().unwrap()[0].created = Instant::now() - TTL;
+        assert!(state.snapshot(&ctx, &id).is_err());
+        let id = state.save_snapshot(&ctx, snapshot.clone()).unwrap();
+        for _ in 0..MAX_ENTRIES {
+            state.save_snapshot(&ctx, snapshot.clone()).unwrap();
+        }
+        assert!(state.snapshot(&ctx, &id).is_err());
+        assert!(state
+            .save_snapshot(
+                &ctx,
+                Snapshot {
+                    bytes: Arc::new(vec![0; MAX_BYTES + 1]),
+                    ..snapshot
+                }
+            )
+            .is_err());
+    }
+}
