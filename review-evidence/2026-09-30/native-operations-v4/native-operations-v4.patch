+fn rename_plan(
+    value: Value,
+    ctx: &ToolCallContext,
+    scope: &Path,
+    language: &str,
+    guards: &[Snapshot],
+    documents: &HashMap<String, Document>,
+) -> Result<(ChangePlan, Value), String> {
+    if !value.is_object() || value.get("changeAnnotations").is_some() {
+        return Err(
+            "unsupported_edit: Expected plain workspace text edits without annotations.".into(),
+        );
+    }
+    let mut targets = std::collections::BTreeMap::<String, Value>::new();
+    match (value.get("changes"), value.get("documentChanges")) {
+        (Some(changes), None) => {
+            for (uri, edits) in changes
+                .as_object()
+                .ok_or("invalid_edit: Expected changes map.")?
+            {
+                targets.insert(uri.clone(), edits.clone());
+            }
+        }
+        (None, Some(changes)) => {
+            for change in changes
+                .as_array()
+                .ok_or("invalid_edit: Expected documentChanges array.")?
+            {
+                if change.get("kind").is_some() {
+                    return Err(
+                        "unsupported_edit: File create/rename/delete operations are not applied."
+                            .into(),
+                    );
+                }
+                let document = change
+                    .get("textDocument")
+                    .ok_or("invalid_edit: Missing textDocument.")?;
+                let uri = document["uri"]
+                    .as_str()
+                    .ok_or("invalid_edit: Missing URI.")?;
+                if let Some(version) = document.get("version").filter(|v| !v.is_null()) {
+                    if documents
+                        .get(uri)
+                        .is_none_or(|doc| version.as_i64() != Some(doc.version))
+                    {
+                        return Err("stale_edit: Document version mismatch.".into());
+                    }
+                }
+                if targets
+                    .insert(
+                        uri.to_owned(),
+                        change
+                            .get("edits")
+                            .cloned()
+                            .ok_or("invalid_edit: Missing edits.")?,
+                    )
+                    .is_some()
+                {
+                    return Err("invalid_edit: Duplicate file target.".into());
+                }
+            }
+        }
+        _ => return Err("invalid_edit: Supply exactly one workspace edit form.".into()),
+    }
+    if targets.is_empty() || targets.len() > 32 {
+        return Err("rename_unavailable: Expected edits to 1–32 files.".into());
+    }
+    let root = workspace_root(ctx)?;
+    let mut files = Vec::new();
+    let mut preview = Vec::new();
+    for (uri, raw) in targets {
+        let input = Url::parse(&uri)
+            .ok()
+            .and_then(|uri| uri.to_file_path().ok())
+            .ok_or("invalid_edit: Only local file URIs are supported.")?;
+        let path = workspace_path(ctx, input.to_str().ok_or("UNSUPPORTED_PATH_ENCODING")?)?;
+        let before = guards.iter().find(|snapshot|snapshot.path==path && language_for(&path,None).is_some_and(|value|server_language(value)==language)).ok_or("edit_outside_scope: Server returned edits outside the synchronized language scope.")?;
+        let text =
+            std::str::from_utf8(&before.bytes).map_err(|_| "invalid_edit: UTF-8 required.")?;
+        let edits: Vec<RenameEdit> = serde_json::from_value(raw)
+            .map_err(|_| "unsupported_edit: Expected unannotated TextEdits.")?;
+        if edits.is_empty() || edits.len() > 1000 {
+            return Err("invalid_edit: Expected 1–1000 edits per file.".into());
+        }
+        let mut ranges = Vec::new();
+        let mut descriptions = Vec::new();
+        for edit in edits {
+            let start = byte_position(text, &edit.range.start)?;
+            let end = byte_position(text, &edit.range.end)?;
+            if end < start || edit.new_text.contains('\0') {
+                return Err("invalid_edit: Invalid text replacement.".into());
+            }
+            let line_start = text
+                .get(..start)
+                .ok_or("invalid_edit: Invalid start boundary.")?
+                .rfind('\n')
+                .map_or(0, |index| index + 1);
+            let line_end = text
+                .get(end..)
+                .ok_or("invalid_edit: Invalid end boundary.")?
