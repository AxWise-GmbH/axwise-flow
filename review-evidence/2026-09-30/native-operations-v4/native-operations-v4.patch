+            assert_eq!(result["verified"], succeeds, "{result}");
+            assert_eq!(
+                fs::read(dir.path().join("a.txt")).unwrap(),
+                if succeeds { b"A\n" } else { b"a\n" }
+            );
+            assert_eq!(
+                fs::read(dir.path().join("b.txt")).unwrap(),
+                if succeeds { b"B\n" } else { b"b\n" }
+            );
+            if !succeeds {
+                assert_eq!(result["rollback"]["restored"], true);
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn duplicate_targets_and_cross_session_handles_never_write() {
+        let (dir, ctx, client) = fixture();
+        let files = changes(&client, &ctx).await;
+        for (context, value) in [
+            (ctx.clone(), json!([files[0], files[0]])),
+            (
