  "contractRationale": {
    "invoice": "All inputs must be safe integers; price and quantity are nonnegative, discount is 0..10000 with default 0. Number.isSafeInteger(-0) is true and -0 satisfies those inclusive ranges. Calls must not reject it.",
    "stock": "Plain stock {a:-0} has a nonempty SKU key and nonnegative safe-integer value. A one-unit reservation is insufficient_stock; empty lines are invalid_lines; empty orders preserve stock with no accepted IDs or rejections.",
    "outputZeroSign": "The contract does not explicitly prescribe the sign of returned zero; the invoice formula can return -0. Returned +0 and -0 are treated as numerically equivalent and their observed signs are informational.",
    "inputImmutability": "Argument contents are compared before and after each invocation, including signed zero via Object.is. Failed reserve calls must return a different remaining object; no extra identity constraint is imposed on fulfillOrders."
  },
  "selection": {
    "requiredUniqueMatrixRows": 48,
    "requiredRowsPerDifficulty": {
      "simple": 16,
      "medium": 16,
      "complex": 16
    },
    "evaluatedDifficulties": [
      "simple",
      "complex"
    ],
    "medium": "Recorded as not_applicable; no medium candidate read or execution.",
    "uniformity": "Every simple solution receives the same 11 cases and every complex solution the same 6 cases. No selection by results, flag configuration, or qualitative review.",
    "reviewMapping": "No private mapping or qualitative review data is read or joined by the runner."
  },
  "caseSemantics": {
