+async fn compact_locations(
+    value: Value,
+    ctx: &ToolCallContext,
+    offset: usize,
+) -> Result<Value, String> {
+    let mut values = match value {
+        Value::Null => Vec::new(),
+        Value::Array(values) => values,
+        value if value.is_object() => vec![value],
+        _ => return Err("protocol_error: Invalid location response.".into()),
+    };
+    values.sort_by_cached_key(|value| {
+        let uri = value
+            .get("uri")
+            .or_else(|| value.get("targetUri"))
+            .and_then(Value::as_str)
+            .unwrap_or("");
+        let range = value
+            .get("range")
+            .or_else(|| value.get("targetSelectionRange"))
+            .unwrap_or(&Value::Null);
+        (
+            uri.to_owned(),
+            range
+                .pointer("/start/line")
+                .and_then(Value::as_u64)
+                .unwrap_or(0),
+            range
+                .pointer("/start/character")
+                .and_then(Value::as_u64)
+                .unwrap_or(0),
+        )
+    });
+    let total = values.len();
+    let root = workspace_root(ctx).map_err(|e| format!("invalid_workspace: {e}"))?;
+    let mut documents: HashMap<PathBuf, String> = HashMap::new();
+    let mut files = serde_json::Map::new();
+    let mut bytes_read = 0;
+    let mut locations = Vec::new();
+    for value in values.into_iter().skip(offset).take(40) {
+        let uri = value
+            .get("uri")
+            .or_else(|| value.get("targetUri"))
+            .and_then(Value::as_str)
+            .ok_or("protocol_error: Location has no URI.")?;
+        let range = value
+            .get("range")
+            .or_else(|| value.get("targetSelectionRange"))
+            .filter(|r| r.is_object())
+            .ok_or("protocol_error: Location has no range.")?;
+        let path = Url::parse(uri).ok().and_then(|url| url.to_file_path().ok());
+        let path = path.and_then(|p| workspace_path(ctx, &p.to_string_lossy()).ok());
+        let Some(path) = path else {
+            locations.push(json!({"uri":uri,"range":range,"external_or_unavailable":true}));
+            continue;
+        };
+        let relative = path
+            .strip_prefix(&root)
+            .map_err(|_| "invalid_path: Reference left the workspace.")?
+            .to_string_lossy()
+            .to_string();
+        if !documents.contains_key(&path) && bytes_read < 8 * 1024 * 1024 {
+            if let Ok(text) = bounded_document(&path).await {
+                bytes_read += text.len();
+                let sha = Sha256::digest(text.as_bytes())
+                    .iter()
+                    .map(|byte| format!("{byte:02x}"))
+                    .collect::<String>();
+                files.insert(relative.clone(), json!({"sha256":sha}));
+                documents.insert(path.clone(), text);
+            }
+        }
+        let line = range
+            .pointer("/start/line")
+            .and_then(Value::as_u64)
+            .and_then(|line| usize::try_from(line).ok());
+        let context = documents
