+fn resolve_symbol(
+    symbols: &Value,
+    selected: &str,
+    uri: &str,
+    text: &str,
+) -> Result<(u32, u32), Value> {
+    let mut stack: Vec<(&Value, String)> = symbols
+        .as_array()
+        .into_iter()
+        .flatten()
+        .map(|value| (value, String::new()))
+        .collect();
+    let mut matches = Vec::new();
+    let mut available = Vec::new();
+    let mut visited = 0;
+    while let Some((value, parent)) = stack.pop() {
+        visited += 1;
+        if visited > 2048 {
+            return Err(
+                json!({"status":"failed","code":"symbol_limit","message":"Use an explicit line/character; the symbol outline exceeds 2048 entries."}),
+            );
+        }
+        let Some(name) = value["name"].as_str() else {
+            continue;
+        };
+        if value
+            .pointer("/location/uri")
+            .and_then(Value::as_str)
+            .is_some_and(|location| location != uri)
+        {
+            continue;
+        }
+        let container = value["containerName"].as_str().unwrap_or(&parent);
+        let qualified = if container.is_empty() {
+            name.to_string()
+        } else {
+            format!("{container}.{name}")
+        };
+        let range = value
+            .get("selectionRange")
+            .or_else(|| value.pointer("/location/range"));
+        if let Some(range) = range {
+            if available.len() < 8 {
+                available.push(qualified.clone());
+            }
+            if selected == name || selected == qualified {
+                if value.get("selectionRange").is_none() {
+                    return Err(
+                        json!({"status":"failed","code":"symbol_position_unavailable","message":"The server returned a declaration range, not an exact name position. Use an explicit line/character."}),
+                    );
+                }
+                let line = range
+                    .pointer("/start/line")
+                    .and_then(Value::as_u64)
+                    .and_then(|n| u32::try_from(n).ok());
+                let character = range
+                    .pointer("/start/character")
+                    .and_then(Value::as_u64)
+                    .and_then(|n| u32::try_from(n).ok());
+                if !valid_position(text, line, character) {
+                    return Err(
+                        json!({"status":"failed","code":"invalid_symbol_position","message":"The server returned an invalid symbol position."}),
+                    );
+                }
+                matches.push(json!({"symbol":qualified,"line":line,"character":character}));
+            }
+        }
+        if let Some(children) = value["children"].as_array() {
+            stack.extend(children.iter().map(|child| (child, qualified.clone())));
+        }
+    }
+    match matches.len() {
+        1 => Ok((
+            matches[0]["line"].as_u64().unwrap() as u32,
+            matches[0]["character"].as_u64().unwrap() as u32,
+        )),
+        0 => Err(
+            json!({"status":"failed","code":"symbol_not_found","symbol":selected,"available":available,"message":"Use a declaration name in this file, or an explicit line/character for a use site."}),
+        ),
+        total => Err(
+            json!({"status":"failed","code":"ambiguous_symbol","symbol":selected,"total":total,"candidates":matches.into_iter().take(8).collect::<Vec<_>>(),"message":"Choose a qualified name or an explicit line/character; no symbol was selected."}),
+        ),
+    }
+}
