# AxWise Frontend — Development Dockerfile
# Runs Next.js dev server with hot-reload for local development

FROM node:20-alpine

WORKDIR /app

# Install dependencies first for better layer caching
COPY frontend/package*.json ./
RUN npm install

# Copy frontend source code
COPY frontend/ ./

# Set OSS development environment
ENV NODE_ENV=development
ENV NEXT_PUBLIC_ENABLE_CLERK_AUTH=false
ENV NEXT_PUBLIC_OSS_MODE=true
ENV NEXT_PUBLIC_ENABLE_ANALYTICS=false
ENV NEXT_PUBLIC_API_URL=http://localhost:8000
ENV PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

# Start Next.js dev server with hot-reload
CMD ["npm", "run", "dev"]
