# AxWise Flow OSS — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ============================================================
# REQUIRED — You must set this to use AxWise
# ============================================================

# Get your free API key from https://aistudio.google.com/app/api_keys
GEMINI_API_KEY=your_gemini_api_key_here
AXWISE_AUTHORITY_PROOF_SECRET=replace_with_at_least_32_random_bytes

# Typed business-evidence projection is dormant by default. The first reviewed
# rollout adapter can be enabled explicitly with: physical_product
AXWISE_BUSINESS_EVIDENCE_PROJECTION_MODELS=

# Production deployment pins this to true and refuses an override to false.
# Local OSS development may leave Clerk validation disabled.
# ENABLE_CLERK_VALIDATION=false

# Shared machine credential for the Orqaly and MCP integration gateway.
# Replace this before exposing the backend outside local development.
AXWISE_API_KEY=local-dev-change-me

# ============================================================
# OPTIONAL — Sensible defaults are provided
# ============================================================

# Exact Gemini model required by durable AxWise research (no model fallback)
# GEMINI_MODEL=models/gemini-3.8-flash

# PostgreSQL password (default: postgres)
# POSTGRES_PASSWORD=postgres

# Backend port (default: 8000)
# BACKEND_PORT=8000

# Frontend port (default: 3000)
# FRONTEND_PORT=3000

# Durable A+B worker polling interval in seconds (default: 1)
# WORKER_POLL_SECONDS=1

# Historical hard-coded twin demo routes stay off unless explicitly enabled.
# ENABLE_DEMO_TWIN_ROUTES=false

# OpenRegister API Key for German B2B company discovery (Get a key from openregister.de)
# OPENREGISTER_API_KEY=your_openregister_api_key_here

# Optional self-hosted SearXNG HTTPS endpoint with JSON search enabled.
# Used only as a secondary grounded source route when Gemini evidence is insufficient.
# SEARXNG_URL=https://search.example.com
