{
  "name": "orchestratori",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run dev:app\" \"npm run dev:api\"",
    "dev:local": "concurrently --restart-tries 5 --restart-after 1500 -n api,web,worker -c cyan,magenta,yellow \"node --watch scripts/local-api-server.js\" \"VITE_API_URL=http://localhost:3001 vite\" \"bash scripts/local-worker.sh\"",
    "dev:api:local": "node --watch scripts/local-api-server.js",
    "start:workflow-v2:api": "node server/workflow-v2/api-main.js",
    "start:workflow-v2:worker": "node server/workflow-v2/worker-main.js",
    "build": "vite build",
    "build:gcp": "vite build --mode gcp-launch",
    "verify:gcp-web": "node deploy/workflow-v2/verify-gcp-web-build.mjs dist",
    "build:landing": "vite build -c vite.landing.config.js && mv dist-landing/landing.html dist-landing/index.html",
    "deploy:landing": "npm run build:landing && gh-pages -d dist-landing -b gh-pages",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:workflow-v2:pg": "node scripts/workflow-v2-real-postgres.mjs",
    "test:workflow-v2:api-pg": "node scripts/workflow-v2-api-postgres.mjs",
    "test:workflow-v2:e2e-local": "node scripts/workflow-v2-local-e2e.mjs",
    "test:workflow-v2:release": "vitest run --maxWorkers=1 lib/workflow-v2 shared/workflow-v2 server/workflow-v2 src/workflow-v2 src/pages/WorkflowV2 scripts/workflow-v2",
    "release:workflow-v2:manifest": "node scripts/workflow-v2-release-manifest.mjs",
    "test:watch": "vitest",
    "verify:workflow-v2-schema": "node scripts/verify-workflow-v2-schema.mjs",
    "validate-env": "node scripts/validate-env.js",
    "validate-env:strict": "node scripts/validate-env.js --strict",
    "dev:app": "vite",
    "dev:api": "node server/transcribe-server.js",
    "dev:bot": "bash scripts/dev-bot.sh",
    "dev:bot:sim": "node scripts/simulate-telegram-update.mjs",
    "verify:metrics": "node scripts/verify-metrics.mjs",
    "format": "prettier --write src/ api/ lib/",
    "format:check": "prettier --check src/ api/ lib/"
  },
  "dependencies": {
    "@clerk/express": "^2.1.63",
    "@clerk/react": "^6.14.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@iconify-json/ph": "^1.2.2",
    "@iconify/react": "^6.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@sentry/react": "^10.41.0",
    "@supabase/supabase-js": "^2.95.3",
    "@upstash/qstash": "^2.10.1",
    "@vercel/functions": "^3.9.2",
    "@vercel/oidc": "^3.8.3",
    "@xyflow/react": "^12.10.0",
    "canonicalize": "4.0.0",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "country-flag-icons": "^1.6.13",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "google-auth-library": "^11.0.2",
    "grapesjs": "^0.22.15",
    "grapesjs-blocks-basic": "^1.0.2",
    "grapesjs-plugin-forms": "^2.0.6",
    "grapesjs-preset-webpage": "^1.0.3",
    "html-to-image": "^1.11.13",
    "js-yaml": "^4.3.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "libsodium-wrappers": "^0.8.3",
    "lottie-react": "^2.4.1",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "megajs": "^1.3.10",
    "micromark-extension-gfm-table": "2.1.1",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^1.5.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.7.0",
    "simple-icons": "^16.20.0",
    "stripe": "^20.4.0",
    "tesseract.js": "^5.1.1",
    "web-speech-cognitive-services": "^8.1.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.110",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "node-mocks-http": "^1.18.1",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "supabase": "^2.76.10",
    "terser": "^5.51.2",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
