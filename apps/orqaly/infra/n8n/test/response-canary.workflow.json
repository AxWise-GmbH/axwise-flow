{
  "id": "orqalyResponseCanary",
  "name": "Orqaly isolated response canary — synthetic data only",
  "nodes": [
    {
      "id": "canary-webhook",
      "name": "Canary Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "local-response-canary",
      "parameters": {
        "httpMethod": "POST",
        "path": "local-response-canary",
