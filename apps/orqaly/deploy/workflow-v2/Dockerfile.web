# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS build

ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_ORQALY_API_URL

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Build only the reviewed GCP launch graph. Vite's gcp-launch mode aliases the
# application entry and rejects legacy runtime imports before emitting assets.
COPY index.html vite.config.js ./
COPY public-gcp ./public-gcp
COPY src ./src
COPY shared/workflow-v2/assistant-events.js shared/workflow-v2/assistant-primitives.js shared/workflow-v2/executable-actions.js shared/workflow-v2/public-https-url.js shared/workflow-v2/solution-build-secrets.js shared/workflow-v2/goal-workflow-view-contract.js shared/workflow-v2/capability-work-primitives.js ./shared/workflow-v2/
COPY deploy/workflow-v2/verify-gcp-web-build.mjs ./deploy/workflow-v2/verify-gcp-web-build.mjs

RUN test -n "$VITE_CLERK_PUBLISHABLE_KEY" \
    && test -n "$VITE_ORQALY_API_URL" \
    && VITE_CLERK_PUBLISHABLE_KEY="$VITE_CLERK_PUBLISHABLE_KEY" \
       VITE_ORQALY_API_URL="$VITE_ORQALY_API_URL" \
       npm run build:gcp \
    && node deploy/workflow-v2/verify-gcp-web-build.mjs dist

FROM nginx:1.27-alpine

# The browser calls the explicit public GCP API origin baked into the verified
# Vite artifact. Nginx serves static files only and has no upstream credentials
# or same-origin compatibility proxy.
COPY deploy/workflow-v2/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/workflow-v2/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
