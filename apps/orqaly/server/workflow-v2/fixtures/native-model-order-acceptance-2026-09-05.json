  "spec": {
    "kind": "n8n_workflow_v2",
    "requirements": [
      {
        "id": "req-receive-order",
        "description": "Receive HTTP POST requests containing order payload {orderId, email, quantity, unitPrice} via Webhook."
      },
      {
        "id": "req-transform-order",
        "description": "Extract fields, compute total price as quantity * unitPrice, and format contactEmail as trimmed lowercase string."
      },
      {
        "id": "req-validate-order",
        "description": "Check that quantity is strictly greater than 0 and unitPrice is greater than or equal to 0."
      },
      {
        "id": "req-respond-accepted",
        "description": "Return HTTP 200 JSON with accepted=true, orderId, contactEmail, and total when order is valid."
      },
      {
        "id": "req-respond-invalid",
        "description": "Return HTTP 422 JSON with accepted=false and error='invalid_order' when order is invalid."
      }
    ],
    "inputSchema": {
      "type": "object",
      "description": "Incoming order payload via HTTP POST body",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "Unique identifier for the order"
        },
        "email": {
          "type": "string",
          "description": "Customer contact email address"
        },
        "quantity": {
          "type": "integer",
          "description": "Item quantity in the order"
        },
        "unitPrice": {
          "type": "number",
          "description": "Price per item unit"
        }
      },
      "required": [
        "orderId",
        "email",
        "quantity",
        "unitPrice"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "description": "Response payload for order processing",
      "properties": {
        "accepted": {
          "type": "boolean",
          "description": "Whether the order passed validation"
        },
        "orderId": {
          "type": "string",
          "description": "Original order identifier"
        },
        "contactEmail": {
          "type": "string",
          "description": "Normalized lowercase trimmed contact email"
        },
        "total": {
          "type": "number",
          "description": "Calculated total price of the order"
        },
        "error": {
          "type": "string",
          "description": "Error identifier when order is rejected"
        }
      },
      "required": [
        "accepted"
      ],
      "additionalProperties": false
    },
