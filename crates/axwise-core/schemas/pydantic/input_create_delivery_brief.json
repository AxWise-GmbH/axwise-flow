{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "title": "Operationid",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "brief": {
      "default": "Prepare a proposed development handoff from the selected PRD.",
      "maxLength": 4000,
      "minLength": 1,
      "title": "Brief",
      "type": "string"
    },
    "depth": {
      "default": "standard",
      "enum": [
        "standard",
        "deep"
      ],
      "title": "Depth",
      "type": "string"
    },
    "references": {
      "description": "Exact saved local artifact references returned by earlier tools in this conversation; never invent or retype artifact content.",
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "maxItems": 8,
      "title": "References",
      "type": "array"
    },
    "requirementIds": {
      "description": "Optional exact requirement IDs from a previous handoff using this same PRD; omit to cover every prioritized requirement.",
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Requirementids",
      "type": "array"
    },
    "revisionOf": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exact prior artifact of this same kind to revise; omit for a new result. Preserves previous versions."
    }
  },
  "title": "DeliveryInput",
  "type": "object"
}