{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "title": "Operationid",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "SelectedStakeholder": {
      "additionalProperties": false,
      "properties": {
        "countryCode": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Countrycode"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "locality": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locality"
        },
        "participants": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Participants",
          "type": "integer"
        },
        "questionIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "maxItems": 6,
          "title": "Questionids",
          "type": "array"
        },
        "questions": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "questions"
      ],
      "title": "SelectedStakeholder",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "depth": {
      "default": "standard",
      "enum": [
        "standard",
        "deep"
      ],
      "title": "Depth",
      "type": "string"
    },
    "problem": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Problem"
    },
    "references": {
      "description": "Exact saved local artifact references returned by earlier tools in this conversation; never invent or retype artifact content.",
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "maxItems": 8,
      "title": "References",
      "type": "array"
    },
    "responseStyle": {
      "default": "mixed",
      "enum": [
        "realistic",
        "optimistic",
        "critical",
        "mixed"
      ],
      "title": "Responsestyle",
      "type": "string"
    },
    "revisionOf": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exact prior artifact of this same kind to revise; omit for a new result. Preserves previous versions."
    },
    "scenario": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario"
    },
    "seed": {
      "default": 0,
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "stakeholders": {
      "description": "Selected groups, or omit to interview saved generated personas using their discovery question plan.",
      "items": {
        "$ref": "#/$defs/SelectedStakeholder"
      },
      "maxItems": 4,
      "title": "Stakeholders",
      "type": "array"
    },
    "targetAudience": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Targetaudience"
    }
  },
  "title": "SimulationInput",
  "type": "object"
}