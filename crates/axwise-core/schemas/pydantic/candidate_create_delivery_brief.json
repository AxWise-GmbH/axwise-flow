{
  "$defs": {
    "AcceptanceTest": {
      "additionalProperties": false,
      "properties": {
        "given": {
          "maxLength": 2000,
          "minLength": 12,
          "title": "Given",
          "type": "string"
        },
        "when": {
          "maxLength": 2000,
          "minLength": 12,
          "title": "When",
          "type": "string"
        },
        "then": {
          "maxLength": 2000,
          "minLength": 12,
          "title": "Then",
          "type": "string"
        },
        "evidenceExpected": {
          "maxLength": 2000,
          "minLength": 12,
          "title": "Evidenceexpected",
          "type": "string"
        }
      },
      "required": [
        "given",
        "when",
        "then",
        "evidenceExpected"
      ],
      "title": "AcceptanceTest",
      "type": "object"
    },
    "ConditionCoverage": {
      "additionalProperties": false,
      "properties": {
        "conditionId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Conditionid",
          "type": "string"
        },
        "status": {
          "enum": [
            "covered",
            "deferred"
          ],
          "title": "Status",
          "type": "string"
        },
        "requirementId": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact selected requirement ID when covered; null when deferred.",
          "title": "Requirementid"
        },
        "acceptanceTestIndex": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Zero-based index into that requirement's proposed acceptanceTests when covered; null when deferred.",
          "title": "Acceptancetestindex"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Specific nonblank reason and unresolved action when deferred; null when covered.",
          "title": "Reason"
        }
      },
      "required": [
        "conditionId",
        "status",
        "requirementId",
        "acceptanceTestIndex",
        "reason"
      ],
      "title": "ConditionCoverage",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "requirementIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Requirementids",
          "type": "array"
        },
        "resolution": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Resolution",
          "type": "string"
        }
      },
      "required": [
        "description",
        "requirementIds",
        "resolution"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "Milestone": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "requirementIds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Requirementids",
          "type": "array"
        },
        "deliverable": {
          "maxLength": 2000,
          "minLength": 12,
          "title": "Deliverable",
          "type": "string"
        },
        "exitCondition": {
          "maxLength": 2000,
          "minLength": 12,
          "title": "Exitcondition",
          "type": "string"
        }
      },
      "required": [
        "title",
        "requirementIds",
        "deliverable",
        "exitCondition"
      ],
      "title": "Milestone",
      "type": "object"
    },
    "RequirementCoverage": {
      "additionalProperties": false,
      "properties": {
        "requirementId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Requirementid",
          "type": "string"
        },
        "acceptanceTests": {
          "items": {
            "$ref": "#/$defs/AcceptanceTest"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Acceptancetests",
          "type": "array"
        }
      },
      "required": [
        "requirementId",
        "acceptanceTests"
      ],
      "title": "RequirementCoverage",
      "type": "object"
    },
    "TechnicalSection": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "enum": [
            "Architecture and modules",
            "Data model",
            "API contracts",
            "Role permissions"
          ],
          "title": "Heading",
          "type": "string"
        },
        "content": {
          "maxLength": 12000,
          "minLength": 60,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "heading",
        "content"
      ],
      "title": "TechnicalSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/RequirementCoverage"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "conditionCoverage": {
      "description": "Exactly one disposition for EVERY supplied acceptanceConditions ID, including Metrics and validation. Never omit a condition because the generated-test budget is full.",
      "items": {
        "$ref": "#/$defs/ConditionCoverage"
      },
      "maxItems": 32,
      "minItems": 2,
      "title": "Conditioncoverage",
      "type": "array"
    },
    "milestones": {
      "items": {
        "$ref": "#/$defs/Milestone"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Milestones",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/Dependency"
      },
      "maxItems": 16,
      "title": "Dependencies",
      "type": "array"
    },
    "proposedExclusions": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Proposedexclusions",
      "type": "array"
    },
    "openQuestions": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Openquestions",
      "type": "array"
    },
    "technicalSections": {
      "items": {
        "$ref": "#/$defs/TechnicalSection"
      },
      "maxItems": 8,
      "title": "Technicalsections",
      "type": "array"
    }
  },
  "required": [
    "title",
    "requirements",
    "conditionCoverage",
    "milestones"
  ],
  "title": "DeliveryCandidate",
  "type": "object"
}
